# NUNCA comite o arquivo .env real. Use chaves com permissão APENAS de trade (sem saque).

# --- Modo de operação ---
# Para enviar ordens reais é preciso VORCARO_LIVE=1 E a flag --live na CLI.
VORCARO_LIVE=0

# --- Cripto (via CCXT: binance, bybit, okx, mercadobitcoin, ...) ---
VORCARO_CCXT_EXCHANGE=binance
VORCARO_CCXT_API_KEY=
VORCARO_CCXT_SECRET=
VORCARO_CCXT_SANDBOX=1

# --- Ações EUA (Alpaca) ---
VORCARO_ALPACA_KEY_ID=
VORCARO_ALPACA_SECRET=
VORCARO_ALPACA_PAPER=1

# --- B3 (MetaTrader 5 da sua corretora: XP, Clear, Rico, Genial, ...) ---
VORCARO_MT5_LOGIN=
VORCARO_MT5_PASSWORD=
VORCARO_MT5_SERVER=
